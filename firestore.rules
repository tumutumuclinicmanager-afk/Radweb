rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 200 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /cases/{caseId} {
      allow read: if true;
      allow create, update, delete: if isValidId(caseId);
    }

    match /transactions/{transactionId} {
      allow read, write: if isValidId(transactionId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}
