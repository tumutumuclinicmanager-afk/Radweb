{
  "entities": {
    "MedicalCase": {
      "title": "MedicalCase",
      "description": "Radiology teaching case with image and clinical details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "modality": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "imageAlt": { "type": "string" },
        "question": { "type": "string" },
        "diagnosis": { "type": "string" },
        "keyFindings": { "type": "array", "items": { "type": "string" } },
        "clinicalSignificance": { "type": "string" },
        "differentialDiagnosis": { "type": "array", "items": { "type": "string" } },
        "reportingTemplate": { "type": "string" },
        "teachingPoints": { "type": "array", "items": { "type": "string" } },
        "cmeTip": { "type": "string" },
        "difficulty": { "type": "string" },
        "galleryImages": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "title", "modality", "category", "imageUrl", "diagnosis"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "M-Pesa or mobile payment transaction record for unlocking full case access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "checkoutRequestId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "mpesaReceiptNumber": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "phoneNumber", "amount", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile with lifetime access credentials and testing permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "isTester": { "type": "boolean" },
        "role": { "type": "string" },
        "testAccountNote": { "type": "string" },
        "grantedBy": { "type": "string" },
        "temporaryPassword": { "type": "string" },
        "mpesaReceiptNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "unlockedAt": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "isPremium"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "System security and administrative credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminPassword": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "adminPassword"]
    }
  },
  "firestore": {
    "/cases/{caseId}": {
      "schema": "MedicalCase",
      "description": "Radiology teaching cases collection"
    },
    "/transactions/{transactionId}": {
      "schema": "PaymentTransaction",
      "description": "Payment transactions collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles with lifetime premium access"
    },
    "/settings/{settingId}": {
      "schema": "AdminSettings",
      "description": "Admin and system configuration records"
    }
  }
}
